@using Application.Dtos.RoomDto
@model List<RoomDto>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h6 class="mb-1 fw-semibold">Daftar Ruangan</h6>
        <div class="small text-muted">Kelola nama ruangan yang dapat digunakan untuk reservasi.</div>
    </div>
    <button class="btn btn-primary btn-sm"
            data-bs-toggle="modal"
            data-bs-target="#modalTambahRoom">
        Tambah
    </button>
</div>

<div class="row g-2 align-items-center mb-3">
    <div class="col-md-5 col-lg-4">
        <div class="input-group input-group-sm">
            <span class="input-group-text">Cari</span>
            <input id="searchRooms" type="search" class="form-control" placeholder="Cari ruangan..." />
        </div>
    </div>
    <div class="col-md text-md-end">
        <span id="infoRooms" class="small text-muted"></span>
    </div>
</div>

<div class="table-responsive">
    <table id="tableRooms" class="table table-hover align-middle w-100">
        <thead class="table-light">
            <tr>
                <th>#</th>
                <th>Nama Ruangan</th>
                <th>Dibuat</th>
                <th>Diperbarui</th>
                <th class="text-center">Aksi</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var (room, index) in Model.Select((item, index) => (item, index + 1)))
            {
                <tr>
                    <td class="text-muted">@index</td>
                    <td class="fw-medium">@room.RoomName</td>
                    <td>@room.CreatedAt.ToString("dd MMM yyyy")</td>
                    <td>@(room.UpdatedAt?.ToString("dd MMM yyyy") ?? "-")</td>
                    <td class="text-center">
                        <div class="btn-group btn-group-sm" role="group" aria-label="Aksi ruangan">
                            <button class="btn btn-outline-primary"
                                    type="button"
                                    data-bs-toggle="modal"
                                    data-bs-target="#modalEditRoom"
                                    data-id="@room.Id"
                                    data-name="@room.RoomName">
                                Edit
                            </button>
                            <button class="btn btn-outline-danger"
                                    type="button"
                                    data-bs-toggle="modal"
                                    data-bs-target="#modalHapusRoom"
                                    data-id="@room.Id"
                                    data-name="@room.RoomName">
                                Hapus
                            </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="modal fade" id="modalTambahRoom" tabindex="-1" aria-labelledby="modalTambahRoomLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form id="formTambahRoom">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h6 class="modal-title fw-semibold" id="modalTambahRoomLabel">Tambah Ruangan</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label">Nama Ruangan</label>
                    <input name="RoomName" type="text" class="form-control" required />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-primary">Simpan</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="modalEditRoom" tabindex="-1" aria-labelledby="modalEditRoomLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form id="formEditRoom">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h6 class="modal-title fw-semibold" id="modalEditRoomLabel">Edit Ruangan</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="Id" id="editRoomId" />
                    <label class="form-label">Nama Ruangan</label>
                    <input name="RoomName" id="editRoomName" type="text" class="form-control" required />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-primary">Simpan Perubahan</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="modalHapusRoom" tabindex="-1" aria-labelledby="modalHapusRoomLabel" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form id="formHapusRoom">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h6 class="modal-title fw-semibold" id="modalHapusRoomLabel">Hapus Ruangan</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button>
                </div>
                <div class="modal-body text-center">
                    <input type="hidden" name="id" id="hapusRoomId" />
                    <p class="mt-3 mb-1">Hapus ruangan <strong id="hapusRoomName"></strong>?</p>
                    <div class="small text-muted">Ruangan yang sudah terhubung reservasi tidak dapat dihapus.</div>
                </div>
                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-danger">Hapus</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function setupRoomTableFilter() {
        const table = document.getElementById('tableRooms');
        const search = document.getElementById('searchRooms');
        const info = document.getElementById('infoRooms');

        if (!table || !search || !info) {
            return;
        }

        const rows = Array.from(table.querySelectorAll('tbody tr'));

        function refreshTable() {
            const keyword = search.value.trim().toLowerCase();
            let visibleRows = 0;

            rows.forEach(row => {
                const isMatch = row.innerText.toLowerCase().includes(keyword);
                row.classList.toggle('d-none', !isMatch);

                if (isMatch) {
                    visibleRows++;
                }
            });

            info.textContent = `${visibleRows} dari ${rows.length} data`;
        }

        search.addEventListener('input', refreshTable);
        refreshTable();
    }

    function initializeRoomPageScript() {
        setupRoomTableFilter();
        setupRoomCreateForm();
        setupRoomEditForm();
        setupRoomDeleteForm();

        const editModal = document.getElementById('modalEditRoom');
        if (editModal) {
            editModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;

                document.getElementById('editRoomId').value = button.dataset.id;
                document.getElementById('editRoomName').value = button.dataset.name;
            });
        }

        const deleteModal = document.getElementById('modalHapusRoom');
        if (deleteModal) {
            deleteModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;

                document.getElementById('hapusRoomId').value = button.dataset.id;
                document.getElementById('hapusRoomName').textContent = button.dataset.name;
            });
        }
    }

    async function sendRoomForm(url, form) {
        try {
            const formData = new FormData(form);

            const response = await fetch(url, {
                method: 'POST',
                body: formData
            });

            return await response.json();
        } catch {
            return {
                success: false,
                message: 'Terjadi kesalahan saat mengirim data.'
            };
        }
    }

    function showRoomResult(result) {
        alert(result.message);

        if (result.success) {
            location.reload();
        }
    }

    function setupRoomCreateForm() {
        const form = document.getElementById('formTambahRoom');
        if (!form) {
            return;
        }

        form.addEventListener('submit', async function (event) {
            event.preventDefault();

            const result = await sendRoomForm('/Admin/CreateRoom', form);
            showRoomResult(result);
        });
    }

    function setupRoomEditForm() {
        const form = document.getElementById('formEditRoom');
        if (!form) {
            return;
        }

        form.addEventListener('submit', async function (event) {
            event.preventDefault();

            const result = await sendRoomForm('/Admin/UpdateRoom', form);
            showRoomResult(result);
        });
    }

    function setupRoomDeleteForm() {
        const form = document.getElementById('formHapusRoom');
        if (!form) {
            return;
        }

        form.addEventListener('submit', async function (event) {
            event.preventDefault();

            const result = await sendRoomForm('/Admin/DeleteRoom', form);
            showRoomResult(result);
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initializeRoomPageScript);
    } else {
        initializeRoomPageScript();
    }
</script>
