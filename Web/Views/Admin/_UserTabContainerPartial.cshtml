@model Web.ViewModels.UserDashboardViewModel

<div class="card shadow-sm">
    <div class="card-header bg-white">
        <ul class="nav nav-tabs card-header-tabs" id="userTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active"
                        id="daftar-pengguna-tab"
                        data-bs-toggle="tab"
                        data-bs-target="#daftar-pengguna"
                        type="button"
                        role="tab"
                        aria-controls="daftar-pengguna"
                        aria-selected="true">
                    <i class="bi bi-people-fill me-1"></i>
                    Daftar Pengguna
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link"
                        id="history-hapus-tab"
                        data-bs-toggle="tab"
                        data-bs-target="#history-hapus"
                        type="button"
                        role="tab"
                        aria-controls="history-hapus"
                        aria-selected="false">
                    <i class="bi bi-trash3-fill me-1"></i>
                    History Hapus Pengguna
                </button>
            </li>
        </ul>
    </div>
    <div class="card-body">
        <div class="tab-content" id="userTabsContent">
            <div class="tab-pane fade show active" id="daftar-pengguna" role="tabpanel" aria-labelledby="daftar-pengguna-tab">
                @await Html.PartialAsync("_UserPartial", Model.ActiveUsers)
            </div>
            <div class="tab-pane fade" id="history-hapus" role="tabpanel" aria-labelledby="history-hapus-tab">
                @await Html.PartialAsync("_UserDeleteHistoryPartial", Model.DeletedUsers)
            </div>
        </div>
    </div>
</div>
