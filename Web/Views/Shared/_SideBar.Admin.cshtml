@{
    var activeMenu = ViewData["ActiveMenu"]?.ToString() ?? "Pengguna";
}

<div class="d-flex flex-column bg-dark text-white p-3" style="width: 260px; min-height: 100vh;">
    <div class="d-flex align-items-center mb-4 pb-3 border-bottom border-secondary">
        <span class="badge text-bg-primary me-2">RS</span>
        <span class="fs-5 fw-semibold">RoomService</span>
    </div>

    <ul class="nav nav-pills flex-column gap-1 flex-grow-1">
        <li class="nav-item">
            <a asp-controller="Admin"
               asp-action="Index"
               class="nav-link @(activeMenu == "Pengguna" ? "active" : "text-white")">
                Pengguna
            </a>
        </li>
        <li class="nav-item">
            <a asp-controller="Admin"
               asp-action="Ruangan"
               class="nav-link @(activeMenu == "Ruangan" ? "active" : "text-white")">
                Ruangan
            </a>
        </li>
    </ul>

    <div class="border-top border-secondary pt-3 mt-3">
        <form asp-controller="Auth" asp-action="Logout" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-danger w-100">
                Logout
            </button>
        </form>
    </div>
</div>
